  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "config": { "clientId": "demo", "clientSecret": "demo" }
    },
    {
      "alias": "github",
      "providerId": "github",
      "enabled": true,
      "config": { "clientId": "demo", "clientSecret": "demo" }
    },
    {
      "alias": "gitlab",
      "providerId": "gitlab",
      "enabled": true,
      "config": { "clientId": "demo", "clientSecret": "demo" }
    },
    {
      "alias": "telegram",
      "displayName": "Telegram",
      "providerId": "oidc",
      "enabled": true,
      "config": {
        "clientId": "demo",
        "clientSecret": "demo",
